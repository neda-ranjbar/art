---
import { getCollection, render } from "astro:content";
// ایمپورت کردن Layout (مسیر را بر اساس ساختار پوشه‌های خود چک کنید)
import Layout from "../../layouts/Layout.astro";

// تابع getStaticPaths برای ساختن مسیرهای داینامیک الزامی است
export async function getStaticPaths() {
  const works = await getCollection("works");

  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
}

// دریافت داده‌ها از props
const { work } = Astro.props;
const { Content } = await render(work);

// مقادیر پیش‌فرض (آرایه‌های خالی) برای جلوگیری از خطای مپ روی undefined
const { coverImage, imageGallery = [], videoGallery = [] } = work.data;
---

<Layout title={`${work.data.title} | Neda Ranjbar`}>
  <article class="portfolio-container">
    <!-- Hero Section -->
    <header class="hero-section">
      <img src={coverImage} alt={work.data.title} class="hero-image" />
      <div class="hero-overlay">
        <h1 class="text-4xl font-bold mb-2">{work.data.title}</h1>
        {
          work.data.description && (
            <p class="text-lg opacity-90">{work.data.description}</p>
          )
        }
      </div>
    </header>

    <div class="content-wrapper my-8 prose max-w-none">
      <Content />
    </div>

    <!-- Combined or Separated Galleries -->
    <section class="gallery-section mt-12">
      <h2 class="text-2xl font-semibold mb-6">Project Media</h2>

      <div class="bento-grid">
        {
          imageGallery.map((img) => (
            <div class={`media-card aspect-${img.aspect}`}>
              <img src={img.src} alt={img.alt} loading="lazy" />
            </div>
          ))
        }

        {
          videoGallery.map((vid) => (
            <div class={`media-card aspect-${vid.aspect}`}>
              <video
                src={vid.src}
                poster={vid.poster}
                controls
                muted
                loop
                playsinline
              />
            </div>
          ))
        }
      </div>
    </section>
  </article>
</Layout>

<style>
  /* --- Base Layout --- */
  .portfolio-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 0; /* پدینگ کناری حذف شد تا با Layout اصلی هماهنگ شود */
  }

  /* --- Hero Image Formatting --- */
  .hero-section {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 400px;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 3rem 2rem 2rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    color: white;
  }

  /* --- The Bento/Masonry Grid --- */
  .bento-grid {
    display: grid;
    /* Base column width is 250px, adapts to screen size */
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    /* 'dense' is the magic word that fills empty gaps automatically */
    grid-auto-flow: dense;
    gap: 1.5rem;
  }

  .media-card {
    border-radius: 0.75rem;
    overflow: hidden;
    background: #f3f4f6; /* Placeholder color while loading */
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .media-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .media-card img,
  .media-card video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Prevents stretching */
    display: block;
  }

  /* --- Aspect Ratio Logic (The Core UX) --- */

  /* 1x1 Grid Space */
  .aspect-square {
    grid-column: span 1;
    grid-row: span 1;
    aspect-ratio: 1 / 1;
  }

  /* 2x1 Grid Space (Wide) */
  .aspect-horizontal {
    grid-column: span 2;
    grid-row: span 1;
    aspect-ratio: 16 / 9; /* Standard widescreen */
  }

  /* 1x2 Grid Space (Tall) */
  .aspect-vertical {
    grid-column: span 1;
    grid-row: span 2;
    aspect-ratio: 9 / 16; /* Standard portrait/mobile */
  }

  /* --- Responsive Adjustments --- */
  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }
    .aspect-horizontal {
      grid-column: span 2;
    }
  }
</style>
