---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import About from "../components/About.astro";

const works = (await getCollection("works")).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const base = import.meta.env.BASE_URL;
---

<Layout title="Neda Ranjbar - 2D Animator">
  <!-- About Section (Full Version) -->
  <About variant="full" />

  <!-- Work Grid Section -->
  <section id="work" class="py-8 md:py-12 scroll-mt-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
      {
        works.map((work) => (
          <a href={`${base}/works/${work.id}#work`} class="group block">
            <div class="overflow-hidden rounded-lg bg-gray-100 mb-4">
              <Image
                src={work.data.coverImage}
                alt={work.data.title}
                class="w-full h-auto block transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <h3 class="text-xl font-medium">{work.data.title}</h3>
            {work.data.description && (
              <p class="text-gray-500 mt-1">{work.data.description}</p>
            )}
          </a>
        ))
      }
    </div>
  </section>
</Layout>
