---
import { getEntry } from "astro:content";

const aboutEntry = await getEntry("about", "about");
const { name, email, instagramHandle, instagramUrl } = aboutEntry!.data;
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---

<footer
  class="max-w-5xl mx-auto px-6 py-12 border-t border-gray-100 mt-16 text-sm text-gray-500">
  <div class="flex flex-col sm:flex-row justify-between items-center gap-6">
    <p>&copy; {currentYear} {name}. All rights reserved.</p>
    <nav class="flex gap-6">
      <a href={`${base}/#work`} class="hover:text-black transition-colors"
        >Work</a
      >
      <a href={`mailto:${email}`} class="hover:text-black transition-colors"
        >Email</a
      >
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black transition-colors">
        {instagramHandle}
      </a>
    </nav>
  </div>
</footer>
