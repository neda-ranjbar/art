---
import "../styles/global.css";
import { Image } from "astro:assets";
// 1. Import getEntry and render from astro:content
import { getEntry, render } from "astro:content";

interface Props {
  title: string;
}
const { title } = Astro.props;

// 2. Fetch the data through the Content Collections API
// (This applies your schema, converting the string into an Image object)
const aboutEntry = await getEntry("about", "about");

if (!aboutEntry) {
  throw new Error("Could not find about.md in the 'about' collection.");
}

// 3. Extract the frontmatter and the Markdown content component
const frontmatter = aboutEntry.data;
const { Content } = await render(aboutEntry);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={`${frontmatter.name} - ${frontmatter.role} Portfolio`}
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <!-- Header -->
    <header
      class="max-w-5xl mx-auto px-6 py-8 flex justify-between items-center sticky top-0 bg-white/90 backdrop-blur-sm z-50">
      <a href="/" class="text-2xl font-medium tracking-tight"
        >{frontmatter.name}</a
      >
      <nav class="space-x-6 text-gray-600">
        <a href="/#work" class="hover:text-black transition-colors">Work</a>
        <a href="#about" class="hover:text-black transition-colors">About</a>
      </nav>
    </header>

    <main class="max-w-5xl mx-auto px-6">
      <!-- Dynamic Page Content (e.g., Project Grid or Single Project) goes here -->
      <slot />
    </main>

    <!-- Global Footer / Detailed About & Resume Section -->
    <footer
      id="about"
      class="max-w-5xl mx-auto px-6 py-16 md:py-24 border-t border-gray-100 mt-16">
      <div class="flex flex-col md:flex-row gap-12 items-start mb-16">
        <div
          class="w-48 h-48 rounded-full overflow-hidden bg-gray-200 shrink-0">
          <Image
            src={frontmatter.profileImage}
            alt={frontmatter.name}
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <h1 class="text-3xl font-medium mb-2">{frontmatter.name}</h1>
          <a
            href={`mailto:${frontmatter.email}`}
            class="text-gray-600 hover:text-black mb-6 inline-block">
            {frontmatter.email}
          </a>
          <div class="text-gray-700 leading-relaxed max-w-2xl">
            <Content />
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-sm">
        <!-- Work History -->
        <div>
          <h3 class="font-bold uppercase tracking-wider mb-6">Work History</h3>
          <div class="space-y-6">
            {
              frontmatter.workHistory.map((job: any) => (
                <div>
                  <h4 class="font-medium text-base">{job.company}</h4>
                  <p class="text-gray-500 mb-1">{job.period}</p>
                  <p class="text-gray-700">{job.role}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Clients -->
        <div>
          <h3 class="font-bold uppercase tracking-wider mb-6">Clients</h3>
          <ul class="space-y-3 text-gray-700">
            {frontmatter.clients.map((client: string) => <li>{client}</li>)}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h3 class="font-bold uppercase tracking-wider mb-6">Contact</h3>
          <ul class="space-y-3 text-gray-700">
            <li>
              <a href={`mailto:${frontmatter.email}`} class="hover:underline">
                {frontmatter.email}
              </a>
            </li>
            <li>{frontmatter.phone}</li>
            <li>
              Instagram: <a
                href={frontmatter.instagramUrl}
                class="hover:underline"
                target="_blank"
                rel="noopener noreferrer">{frontmatter.instagramHandle}</a
              >
            </li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
