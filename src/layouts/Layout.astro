---
import "../styles/global.css";
import { getEntry } from "astro:content";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;

// Fetch 'about' data for header and meta tags
const aboutEntry = await getEntry("about", "about");
if (!aboutEntry) {
  throw new Error("Could not find about.md in the 'about' collection.");
}
const frontmatter = aboutEntry.data;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={`${frontmatter.name} - ${frontmatter.role} Portfolio`}
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <!-- Header -->
    <header
      class="max-w-5xl mx-auto px-6 py-8 flex justify-between items-center sticky top-0 bg-white/90 backdrop-blur-sm z-50">
      <a href={`${base}/`} class="text-2xl font-medium tracking-tight"
        >{frontmatter.name}</a
      >
      <nav class="space-x-6 text-gray-600">
        <a href={`${base}/#work`} class="hover:text-black transition-colors"
          >Work</a
        >
        <a href={`${base}/#about`} class="hover:text-black transition-colors"
          >About</a
        >
      </nav>
    </header>

    <main class="max-w-5xl mx-auto px-6">
      <!-- Dynamic Page Content (e.g., Project Grid or Single Project) goes here -->
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
